        "id": "54b1334",
        "settings": {
         "editor": "<p><strong>CO BUDEME NA VÝROBU LISTOPADOVÉ DEKORACE POTŘEBOVAT:</strong></p><ul><li>Malý zbytek látky cca 40x30cm</li><li>Mašli nebo stuhu</li><li>Úplně obyčejný provázek</li><li>3 Šišky</li><li>Nůžky a šicí potřeby = nit a jehlu</li><li>A něco na lepení – může být i aranžérská pistole, která poslouží na lepení také dobře</li></ul>",
         "pa_condition_repeater": [],
         "premium_tooltip_position": "top,bottom",
         "premium_tooltip_text": "Hi, I'm a global tooltip."
        },
        "widgetType": "text-editor"
       }
