        "id": "80b6a64",
        "settings": {
         "editor": "<p><strong>CO BUDEME NA VÝROBU PROSINCOVÉ DEKORACE POTŘEBOVAT:</strong></p><ul><li>Dřevěné špalíčky nařezané z větve stromu v tloušťce cca 1 – 1,5 cm.</li><li>Šňůrku či ozdobný provázek.</li><li>Nůžky.</li><li>Fixu a propisku, event. kousek papíru na zapsání poděkování či přání.</li></ul>",
         "pa_condition_repeater": [
          {
           "_id": "0c883c3"
          }
         ],
         "premium_tooltip_position": "top,bottom",
         "premium_tooltip_text": "Hi, I'm a global tooltip."
