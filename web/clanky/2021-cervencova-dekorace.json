         "editor": "<p><strong>CO BUDEME NA VÝROBU ČERVENCOVÉ DEKORACE POTŘEBOVAT:</strong></p><ul><li>VLASTNĚ SKORO NIC :-)</li><li>Pár kamínků nebo oblázků libovolné velikosti</li><li>Fixy nebo kuličkové pero</li></ul>"
        },
        "widgetType": "text-editor"
